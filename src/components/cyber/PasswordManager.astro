---
import Scene from './Scene.astro';
import Icon from '../Icon.astro';
const sites = [
  { name: 'gmail.com', pw: 'vR8#qL2m!Tz9wKp4' },
  { name: 'amazon.com', pw: 'nB4$hY7cQe1!sXr6' },
  { name: 'yourbank.com', pw: 'Jt6@pW3zMu8&dLa2' },
  { name: 'pizzaplace.com', pw: 'eC9!kF5vRn2#yHq7' },
];
const apps = [
  { name: 'Bitwarden', note: 'Free, open source', icon: { type: 'simple-icons', name: 'bitwarden' }, color: '#175DDC' },
  { name: '1Password', note: 'Polished, paid', icon: { type: 'simple-icons', name: '1password' }, color: '#3B66BC' },
  { name: 'Apple Passwords', note: 'Built into iPhone & Mac', icon: { type: 'simple-icons', name: 'apple' }, color: '#e8e8e8' },
  { name: 'Google Password Manager', note: 'Built into Chrome & Android', icon: { type: 'simple-icons', name: 'google' }, color: '#4285F4' },
  { name: 'Proton Pass', note: 'Privacy-focused', icon: { type: 'simple-icons', name: 'proton' }, color: '#8b6cf6' },
] as const;
---
<Scene slide={Astro.props.slide} label="You remember one password. The manager remembers the rest.">
  <div class="pm">
    <div class="pm-head a-up">
      <div class="cs-kicker">Password managers</div>
      <h3 class="cs-h">Remember one password, not a hundred</h3>
    </div>
    <div class="pm-body">
      <div class="pm-flow">
        <div class="pm-master a-left" style="--d:.6s">
          <span class="cs-mono cs-muted">You remember one:</span>
          <span class="cs-mono">maple trombone sunday gravel</span>
          <span class="pm-plus cs-muted">+ two-factor</span>
        </div>
        <div class="pm-vault a-pop" style="--d:1.4s">
          <span class="pm-lock"><Icon type="lucide" name="lock-keyhole" width={24} height={24} viewBox="0 0 24 24" /></span>
          <div>
            <b>Your vault</b>
            <span class="cs-muted">Encrypted on your device. Even the company can't read it.</span>
          </div>
        </div>
        <div class="pm-sites">
          {sites.map((s, i) => (
            <div class="pm-site a-right" style={`--d:${2.2 + i * 0.5}s`}>
              <span class="pm-name">{s.name}</span>
              <span class="pm-pw cs-mono">
                <span class="pm-dots">••••••••••••••••</span>
                <span class="pm-real a-fade" style={`--d:${2.8 + i * 0.5}s`}>{s.pw}</span>
              </span>
            </div>
          ))}
          <div class="pm-site pm-fake a-right" style="--d:5s">
            <span class="pm-name cs-red">amaz0n-login.co</span>
            <span class="pm-no cs-mono a-pop" style="--d:5.6s">✕ won't autofill: wrong site</span>
          </div>
        </div>
      </div>
      <div class="pm-apps">
        <span class="cs-mono cs-muted pm-pick a-fade" style="--d:6.4s">Pick one:</span>
        {apps.map((a, i) => (
          <div class="pm-app a-up" style={`--d:${6.7 + i * 0.35}s`}>
            <span class="pm-ic" style={`color:${a.color}`}><Icon type={a.icon.type} name={a.icon.name as any} width={24} height={24} viewBox="0 0 24 24" /></span>
            <div><b>{a.name}</b><span>{a.note}</span></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Scene>
<style>
  .pm { position: absolute; inset: 0; padding: 4cqw 5cqw; display: flex; flex-direction: column; gap: 2.4cqw; }
  .pm-body { flex: 1; display: grid; grid-template-columns: 1.45fr 1fr; gap: 3.5cqw; min-height: 0; }
  .pm-flow { display: flex; flex-direction: column; gap: 1.2cqw; }
  .pm-master { display: flex; flex-direction: column; gap: .3cqw; font-size: 1.7cqw; border: 1px solid var(--line); background: var(--card); padding: 1cqw 1.4cqw; }
  .pm-master .cs-muted { font-size: 1.2cqw; }
  .pm-plus { font-size: 1.3cqw; }
  .pm-vault { display: flex; align-items: center; gap: 1.4cqw; border: 1px solid var(--purple); background: rgba(140,92,245,.12); padding: 1cqw 1.4cqw; font-size: 1.7cqw; }
  .pm-vault div { display: flex; flex-direction: column; }
  .pm-vault .cs-muted { font-size: 1.25cqw; }
  .pm-lock :global(svg) { width: 3.2cqw; height: 3.2cqw; display: block; color: var(--purple-light); }
  .pm-sites { display: flex; flex-direction: column; gap: .6cqw; }
  .pm-site { display: grid; grid-template-columns: 14cqw 1fr; align-items: center; gap: 1cqw; border: 1px solid var(--line); padding: .55cqw 1.2cqw; font-size: 1.45cqw; }
  .pm-pw { display: inline-grid; font-size: 1.4cqw; }
  .pm-pw > span { grid-area: 1 / 1; }
  .pm-dots { color: var(--muted); }
  .pm-real { color: var(--green); background: #050505; }
  .pm-fake { border-color: rgba(255,77,79,.5); }
  .pm-no { font-size: 1.3cqw; color: var(--green); }
  .pm-apps { display: flex; flex-direction: column; gap: .8cqw; }
  .pm-pick { font-size: 1.3cqw; }
  .pm-app { display: grid; grid-template-columns: 3cqw 1fr; align-items: center; gap: 1.2cqw; background: var(--card); border: 1px solid var(--line); padding: .8cqw 1.2cqw; }
  .pm-app div { display: flex; flex-direction: column; font-size: 1.6cqw; }
  .pm-app span:not(.pm-ic) { font-size: 1.2cqw; color: var(--muted); }
  .pm-ic :global(svg) { width: 2.6cqw; height: 2.6cqw; display: block; }
</style>
