---
import Scene from './Scene.astro';
// Microsoft-reported password attacks per second (Entra / Microsoft accounts).
const data = [
  { year: '2015', v: 115 },
  { year: '2022', v: 921 },
  { year: '2023', v: 4000 },
  { year: '2024', v: 7000 },
  { year: '2026', v: 5200, est: true },
];
const max = 7000;
---
<Scene slide={Astro.props.slide} slide={Astro.props.slide}
  label="Password attacks Microsoft blocks every second, by year."
  source="Microsoft (Digital Defense Reports 2022 and 2024, May 2024 passkeys announcement)"
>
  <div class="pa">
    <div class="pa-left">
      <div class="a-up">
        <div class="cs-kicker">Microsoft sign-in data</div>
        <h3 class="cs-h">Password attacks<br />per second</h3>
      </div>
      <div class="pa-chart">
        {data.map((d, i) => (
          <div class="pa-col">
            <span class="pa-val cs-mono a-fade" style={`--d:${0.9 + i * 0.6 + 1}s`}>{d.est ? '~' : ''}{d.v.toLocaleString('en-US')}</span>
            <div class={`pa-bar a-grow-y ${d.est ? 'est' : ''}`} style={`height:${Math.max(1.5, (d.v / max) * 100)}%;--d:${0.9 + i * 0.6}s;--dur:1.4s`}></div>
            <span class="pa-year cs-mono">{d.year}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="pa-right">
      <div class="pa-stat a-up" style="--d:4.2s">
        <span class="pa-big cs-red"><span data-count="7000" data-delay="4200" data-dur="1200">7,000</span></span>
        <span class="cs-p">a second at the peak. <b>~600 million a day.</b></span>
      </div>
      <div class="pa-stat a-up" style="--d:5.8s">
        <span class="pa-big cs-green">&minus;26%</span>
        <span class="cs-p">in 2026, the first drop. 2FA and passkeys are working.</span>
      </div>
      <div class="pa-live a-up" style="--d:7.4s">
        <span class="cs-mono cs-muted">So attackers switched to:</span>
        <span class="pa-shift">Fake login pages that steal your session <b class="cs-red">2×+</b></span>
        <span class="pa-shift">“Paste this to verify” scams <b class="cs-red">8×</b></span>
      </div>
    </div>
  </div>
</Scene>
<style>
  .pa { position: absolute; inset: 0; padding: 4.5cqw 5cqw; display: grid; grid-template-columns: 1.15fr 1fr; gap: 5cqw; }
  .pa-left { display: flex; flex-direction: column; gap: 2cqw; min-height: 0; }
  .pa-chart { flex: 1; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.6cqw; align-items: end; border-bottom: 1px solid var(--line); min-height: 0; }
  .pa-col { height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: .6cqw; position: relative; padding-bottom: 3cqw; }
  .pa-bar { width: 100%; background: linear-gradient(180deg, var(--red), rgba(255,77,79,.25)); border: 1px solid var(--red); border-bottom: none; }
  .pa-col:nth-child(-n+2) .pa-bar { background: linear-gradient(180deg, var(--purple), rgba(140,92,245,.25)); border-color: var(--purple); }
  .pa-bar.est { background: repeating-linear-gradient(135deg, rgba(255,77,79,.45) 0 .6cqw, rgba(255,77,79,.15) .6cqw 1.2cqw); border-style: dashed; }
  .pa-val { font-size: 1.5cqw; }
  .pa-year { position: absolute; bottom: 0; font-size: 1.4cqw; color: var(--muted); }
  .pa-right { display: flex; flex-direction: column; justify-content: center; gap: 2.6cqw; }
  .pa-stat { display: flex; flex-direction: column; }
  .pa-big { font-size: 6cqw; font-weight: 800; letter-spacing: -.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .pa-live { border-top: 1px solid var(--line); padding-top: 2cqw; display: flex; flex-direction: column; gap: .5cqw; font-size: 1.5cqw; }
  .pa-shift { font-size: 1.8cqw; }
</style>
