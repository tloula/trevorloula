---
import Scene from './Scene.astro';
// Search space ("how many guesses to be sure"), shown on a log scale.
const rows = [
  { pw: 'Summer2026!', note: 'Ticks every box. Still on every guess list.', guesses: 'a few million', log: 6.5, color: 'var(--red)', rules: true },
  { pw: 'x7#Kp2!q', note: '8 random characters, all the symbols', guesses: '6.6 quadrillion', log: 15.8, color: 'var(--amber)' },
  { pw: 'maple trombone sunday gravel lantern', note: '5 random words. Easy to type and remember.', guesses: '28 quintillion', log: 19.4, color: 'var(--green)' },
];
---
<Scene slide={Astro.props.slide} label="How many guesses it takes to be sure you'd crack it (log scale)." source="NIST SP 800-63B-4 (no composition rules); math: 95⁸ vs. 7,776⁵ word combinations">
  <div class="ps">
    <div class="a-up">
      <div class="cs-kicker">What "strong" actually means</div>
      <h3 class="cs-h">Long beats <span class="cs-muted">complicated</span></h3>
    </div>
    <div class="ps-rows">
      {rows.map((r, i) => (
        <div class="ps-row">
          <div class="ps-pw a-left" style={`--d:${0.6 + i * 1.6}s`}>
            <span class="cs-mono">{r.pw}</span>
            <span class="ps-note">{r.note}</span>
          </div>
          <div class="ps-track">
            <div class="ps-bar a-grow-x" style={`width:${(r.log / 20) * 100}%;background:${r.color};--d:${1.1 + i * 1.6}s;--dur:1.4s`}></div>
            <span class="ps-g cs-mono a-fade" style={`--d:${1.9 + i * 1.6}s;color:${r.color}`}>{r.guesses}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="ps-foot">
      <div class="ps-rule a-pop" style="--d:6.4s">
        <span class="cs-red">✕</span> “Password must contain a symbol”
        <span class="cs-muted">... rejects the strongest one here.</span>
      </div>
      <p class="cs-p a-up" style="--d:7.4s">Five random words is <b class="cs-green">~4,000×</b> harder than eight random symbols.</p>
    </div>
  </div>
</Scene>
<style>
  .ps { position: absolute; inset: 0; padding: 4.5cqw 5cqw; display: flex; flex-direction: column; gap: 3cqw; }
  .ps-rows { display: flex; flex-direction: column; gap: 2.4cqw; }
  .ps-row { display: grid; grid-template-columns: 34cqw 1fr; gap: 2cqw; align-items: center; }
  .ps-pw { display: flex; flex-direction: column; gap: .3cqw; }
  .ps-pw .cs-mono { font-size: 2cqw; background: var(--card); border: 1px solid var(--line); padding: .6cqw 1cqw; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ps-note { font-size: 1.3cqw; color: var(--muted); }
  .ps-track { position: relative; height: 3cqw; display: flex; align-items: center; gap: 1cqw; }
  .ps-bar { height: 100%; min-width: .6cqw; opacity: .85; }
  .ps-g { font-size: 1.6cqw; white-space: nowrap; }
  .ps-foot { margin-top: auto; display: flex; flex-direction: column; gap: 1.2cqw; }
  .ps-rule { align-self: flex-start; border: 1px solid var(--line); background: var(--card); padding: .8cqw 1.4cqw; font-size: 1.7cqw; }
</style>
