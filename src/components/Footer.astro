---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
const socials = (await getCollection('socials')).sort((a, b) => a.data.id - b.data.id);
---

<footer class="footer">
  <div class="footer-content">
    <span class="footer-copy">© {currentYear} Trevor Loula</span>
    <nav class="footer-links" aria-label="Footer">
      {socials.map((item) => (
        <a
          href={item.data.link}
          class="footer-icon"
          aria-label={item.data.text}
          title={item.data.text}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon type={item.data.icon.type} name={item.data.icon.name} width={16} height={16} viewBox="0 0 24 24" />
        </a>
      ))}
      <a href="/rss.xml" class="footer-icon" aria-label="RSS feed" title="RSS feed">
        <Icon type="lucide" name="rss" width={16} height={16} viewBox="0 0 24 24" />
      </a>
      <span class="footer-divider" aria-hidden="true"></span>
      <a href="/privacy/" class="footer-link">Privacy</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    width: 100%;
    margin-top: 3rem;
    font-family: 'Geist Mono', monospace;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1.25rem 0;
    border-top: 1px solid #1a1a1a;
    color: #8d8d8d;
    font-size: 0.8rem;
    letter-spacing: 0.01em;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .footer-icon,
  .footer-link {
    color: #8d8d8d;
    text-decoration: none;
    transition: color 0.2s, filter 0.2s;
  }

  .footer-icon {
    display: inline-flex;
    padding: 0.375rem;
  }

  .footer-link {
    padding: 0.25rem 0 0.25rem 0.375rem;
  }

  .footer-icon:hover,
  .footer-icon:focus-visible,
  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--primary-lightest);
    filter: drop-shadow(0 0 6px var(--primary));
    outline: none;
  }

  .footer-divider {
    width: 1px;
    height: 0.9rem;
    margin: 0 0.5rem;
    background-color: #2a2a2a;
  }

  @media screen and (max-width: 640px) {
    .footer {
      margin-top: 2rem;
    }

    .footer-content {
      flex-direction: column-reverse;
      gap: 0.5rem;
      padding: 1.25rem 1rem;
    }
  }
</style>
